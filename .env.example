# ==============================================================================
# TACHY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env` lalu isi nilai-nilai sesuai kebutuhan environment Anda.
# Perintah cepat salin: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL) - WAJIB
# ------------------------------------------------------------------------------
# Untuk apa: Menyimpan data pengguna, sesi, tes mengetik, audit log, file, dan branding.
# Dapat dari mana: 
#   - Layanan cloud gratis: Neon (https://neon.tech), Supabase (https://supabase.com), atau Railway.
#   - Atau PostgreSQL lokal (misal: postgresql://postgres:postgres@localhost:5432/tachy).
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/tachy?sslmode=require

# Untuk apa: Koneksi langsung ke database tanpa connection pooling (dibutuhkan untuk migration Drizzle ORM).
# Dapat dari mana: Di dashboard Neon/Supabase, pilih tab "Direct Connection" (port 5432).
DIRECT_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/tachy?sslmode=require


# ------------------------------------------------------------------------------
# 2. AUTENTIKASI & KEAMANAN (Better Auth & Anti-Cheat) - WAJIB
# ------------------------------------------------------------------------------
# Untuk apa: Kunci rahasia untuk menandatangani dan mengenkripsi cookie session login pengguna.
# Dapat dari mana: Dibuat sendiri di terminal dengan perintah: openssl rand -hex 32
BETTER_AUTH_SECRET=ganti_dengan_random_string_minimal_32_karakter

# Untuk apa: Menentukan domain asal autentikasi, validasi keamanan cookie, dan URL redirect login.
# Nilai:
#   - Development: http://localhost:3000
#   - Production : https://domainanda.com (wajib diawali https:// dan tanpa garis miring di akhir)
BETTER_AUTH_URL=http://localhost:3000

# Untuk apa: Kunci rahasia enkripsi token telemetry anti-cheat saat pengguna mulai mengetik.
# Dapat dari mana: Dibuat sendiri di terminal dengan perintah: openssl rand -hex 32
TEST_TOKEN_SECRET=ganti_dengan_random_string_minimal_32_karakter


# ------------------------------------------------------------------------------
# 3. DOMAIN & METADATA SITUS - WAJIB DI PRODUCTION
# ------------------------------------------------------------------------------
# Untuk apa: URL kanonikal publik untuk SEO sitemap, kartu OpenGraph (social preview), dan watermark kartu share.
# Nilai:
#   - Development: http://localhost:3000
#   - Production : https://domainanda.com (tanpa garis miring di akhir)
NUXT_PUBLIC_SITE_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# 4. KEAMANAN PORTAL ADMIN (Admin Panel Security) - WAJIB
# ------------------------------------------------------------------------------
# Untuk apa: Menentukan URL login admin yang tersembunyi (menghindari brute-force di URL umum seperti /admin).
# Nilai: String acak yang hanya diketahui tim admin (contoh: 'tachyPanel' -> akses via https://domainanda.com/tachyPanel).
ADMIN_LOGIN_PATH=tachyPanel

# Untuk apa: Prefix path dashboard admin setelah berhasil login.
# Nilai: String acak yang hanya diketahui tim admin (contoh: 'tachos' -> dashboard di https://domainanda.com/tachos/dashboard).
ADMIN_PANEL_PREFIX=tachos

# Untuk apa: Mewajibkan autentikasi 2-Faktor (TOTP / Google Authenticator) bagi akun admin.
# Nilai: 'true' (sangat disarankan di production) atau 'false' (development).
ADMIN_REQUIRE_2FA=false

# Untuk apa: Membatasi akses portal admin hanya untuk IP tertentu (IP Whitelist).
# Dapat dari mana: IP publik statis kantor/VPN Anda (cek di https://ifconfig.me).
# Nilai: Kosongkan jika IP Anda dinamis, atau isi IP dipisahkan koma (contoh: 103.21.244.2,180.252.1.10).
ADMIN_IP_ALLOWLIST=


# ------------------------------------------------------------------------------
# 5. CACHE & RATE LIMITING (Upstash Redis) - SANGAT DISARANKAN DI PRODUCTION
# ------------------------------------------------------------------------------
# Untuk apa: Proteksi rate limiting (mencegah spam submission tes dan brute force login) serta caching leaderboard.
# Dapat dari mana: Buat database serverless Redis gratis di https://console.upstash.com, lalu salin REST API credentials.
# Catatan: Jika dikosongkan, aplikasi tetap berjalan normal tetapi rate limiting otomatis dinonaktifkan.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ------------------------------------------------------------------------------
# 6. LAYANAN EMAIL TRANSAKSIONAL (Resend) - DISARANKAN
# ------------------------------------------------------------------------------
# Untuk apa: Mengirimkan email verifikasi akun baru dan tautan reset kata sandi ke inbox member.
# Dapat dari mana: Buat akun di https://resend.com > API Keys > Create API Key.
# Catatan: Jika dikosongkan, email hanya akan dicetak di console log server (berguna saat dev).
EMAIL_API_KEY=

# Untuk apa: Alamat email pengirim yang tampil di inbox pengguna.
# Dapat dari mana: Alamat email domain Anda yang sudah diverifikasi DNS-nya di dashboard Resend.
# Contoh: Tachy <noreply@domainanda.com>
EMAIL_FROM=Tachy <noreply@tachy.app>


# ------------------------------------------------------------------------------
# 7. SOCIAL LOGIN / OAUTH (Opsional)
# ------------------------------------------------------------------------------
# Untuk apa: Memungkinkan pengguna mendaftar dan login 1-klik menggunakan akun Google.
# Dapat dari mana: Google Cloud Console (https://console.cloud.google.com) > Credentials > OAuth 2.0 Client IDs.
#   - Authorized redirect URI: https://domainanda.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Untuk apa: Memungkinkan pengguna mendaftar dan login 1-klik menggunakan akun GitHub.
# Dapat dari mana: GitHub > Settings > Developer Settings > OAuth Apps > New OAuth App.
#   - Authorization callback URL: https://domainanda.com/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# ------------------------------------------------------------------------------
# 8. OBJECT STORAGE (Supabase Storage - Opsional)
# ------------------------------------------------------------------------------
# Untuk apa: Penyimpanan bucket S3 eksternal untuk file upload dan asset branding.
# Dapat dari mana: Dashboard project Supabase (https://supabase.com) > Project Settings > API.
# Catatan: BISA DIKOSONGKAN. Jika kosong, Tachy otomatis menyimpan dan men-stream file secara mandiri via internal database.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------------------
# 9. SEO & WEBMASTER VERIFICATION (Opsional)
# ------------------------------------------------------------------------------
# Untuk apa: Tag verifikasi kepemilikan domain di Google Search Console dan Bing Webmaster.
# Catatan: Bisa juga diatur langsung melalui Admin Panel > Settings > SEO.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=


# ------------------------------------------------------------------------------
# 10. ERROR MONITORING & SYSTEM ALERTS (Opsional)
# ------------------------------------------------------------------------------
# Untuk apa: Pelacakan otomatis error dan exception di production secara real-time.
# Dapat dari mana: DSN project di https://sentry.io.
SENTRY_DSN=

# Untuk apa: Mengirimkan notifikasi instan ke channel Discord / Slack jika terjadi issue pada server.
# Dapat dari mana: Salin Webhook URL dari channel Discord/Slack Anda.
ALERT_WEBHOOK_URL=
